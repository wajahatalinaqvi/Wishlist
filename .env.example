# .env.example
# Copy this file to ".env" and fill in your values.
# The .env file is git-ignored and should never be committed.

# Your store's myshopify domain — no https://, no trailing slash.
# Example: my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Admin API access token from your custom Shopify app (starts with shpat_).
# See README.md for how to create one.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Port the server listens on when running locally.
PORT=3000
